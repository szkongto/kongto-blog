# ============================================================
# Netlify Redirects - cncdisplay.com
# 301 Permanent Redirects + 404 Handling
# ============================================================

# Canonical URL redirects (root -> /posts/ for articles)
/article_*  /posts/:splat 301
/en/article_*  /en/posts/:splat 301

# Brand pages (clean URL -> .html)
/brands/:brand  /brands/:brand.html 301
/en/brands/:brand  /en/brands/:brand.html 301

# Index redirects
/index.html  / 301
/en/index.html  /en/ 301

# HSTS Security Headers
/*  /  200!
  Content-Security-Policy: default-src 'self' https://zz.bdstatic.com https://push.zhanzhang.baidu.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://zz.bdstatic.com https://push.zhanzhang.baidu.com
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin

# 404 Handling
/*  /404.html 404
