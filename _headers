# Cloudflare Pages Security Headers - cncdisplay.com
# Fixes: Missing HSTS, CSP, X-Frame-Options, X-Content-Type-Options, Referrer-Policy

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# HTML pages only
/*.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://zz.bdstatic.com https://push.zhanzhang.baidu.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https:; frame-src 'none'; object-src 'none'

# Images and static assets - long cache
/images/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

# PDFs
/*.pdf
  Cache-Control: public, max-age=86400
