diff --git a/fix_canonical_og.py b/fix_canonical_og.py
new file mode 100644
index 00000000..8d7382c2
--- /dev/null
+++ b/fix_canonical_og.py
@@ -0,0 +1,86 @@
+import os, re
+
+repo = '.'
+base_url = 'https://cncdisplay.com'
+fixed = 0
+errors = []
+
+for root, dirs, files in os.walk(repo):
+    # Skip unnecessary dirs
+    dirs[:] = [d for d in dirs if not d.startswith('.') and d not in ('images', 'css', 'schema', 'docs', 'images_backup_compressed', 'backlinks_output', 'backlinks_daily')]
+    for f in files:
+        if not f.endswith('.html'):
+            continue
+        fpath = os.path.join(root, f)
+        rel = fpath[len(repo)+1:].replace('\\', '/')
+        
+        with open(fpath, 'r', encoding='utf-8', errors='ignore') as fp:
+            content = fp.read()
+        
+        # Generate the correct canonical URL
+        # For index.html in root -> /
+        # For en/index.html -> /en/
+        # For other .html files -> /path/to/file.html
+        if rel == 'index.html':
+            correct_url = base_url + '/'
+        elif rel.endswith('/index.html'):
+            # e.g. en/index.html -> /en/
+            correct_url = base_url + '/' + rel[:-11] + '/'
+        else:
+            correct_url = base_url + '/' + rel
+        
+        # Check current canonical
+        canonical_match = re.search(r'<link rel="canonical" href="([^"]*)"', content)
+        og_url_match = re.search(r'<meta property="og:url" content="([^"]*)"', content)
+        
+        new_content = content
+        changed = False
+        
+        # Fix canonical if wrong or missing
+        if canonical_match:
+            current_canonical = canonical_match.group(1)
+            if current_canonical != correct_url:
+                new_content = new_content.replace(
+                    f'<link rel="canonical" href="{current_canonical}"',
+                    f'<link rel="canonical" href="{correct_url}"'
+                )
+                changed = True
+        else:
+            # Add canonical before </head>
+            head_close = new_content.find('</head>')
+            if head_close > 0:
+                new_content = new_content[:head_close] + f'    <link rel="canonical" href="{correct_url}">\n' + new_content[head_close:]
+                changed = True
+        
+        # Fix og:url
+        if og_url_match:
+            current_og = og_url_match.group(1)
+            if current_og != correct_url:
+                new_content = new_content.replace(
+                    f'<meta property="og:url" content="{current_og}"',
+                    f'<meta property="og:url" content="{correct_url}"'
+                )
+                changed = True
+        else:
+            # Add og:url before </head> or after og:title
+            og_title_pos = new_content.find('og:title')
+            if og_title_pos > 0:
+                # Insert og:url after the og:title line
+                line_end = new_content.find('\n', og_title_pos)
+                if line_end > 0:
+                    new_content = new_content[:line_end+1] + f'    <meta property="og:url" content="{correct_url}">\n' + new_content[line_end+1:]
+                    changed = True
+            else:
+                # Insert before </head>
+                head_close = new_content.find('</head>')
+                if head_close > 0:
+                    new_content = new_content[:head_close] + f'    <meta property="og:url" content="{correct_url}">\n' + new_content[head_close:]
+                    changed = True
+        
+        if changed:
+            with open(fpath, 'w', encoding='utf-8') as fp:
+                fp.write(new_content)
+            fixed += 1
+            print(f"Fixed: {rel}")
+
+print(f"\nTotal fixed: {fixed}")
diff --git a/fix_duplicate_a61l.py b/fix_duplicate_a61l.py
new file mode 100644
index 00000000..8ddb50d2
--- /dev/null
+++ b/fix_duplicate_a61l.py
@@ -0,0 +1,104 @@
+import os, re
+
+repo = '.'
+
+# Authoritative pages
+auth_cn = 'https://cncdisplay.com/posts/article_20260526_FANUC_A61L_0001_0093_LCD_Upgrade_Guide.html'
+auth_en = 'https://cncdisplay.com/en/posts/article_20260526_FANUC_A61L_0001_0093_LCD_Upgrade_Complete_Guide.html'
+
+# Duplicate pages (will add canonical pointing to authoritative)
+dups_cn = [
+    'posts/article_20260503_FANUC_A61L_0001_0093_LCD.html',
+    'posts/article_20260503_FANUC_D9MM_11A_0093_LCD.html',
+    'posts/fanuc-a61l-0001-0093-display-faq-zh.html',
+    'posts/fanuc-a61l-0001-0093-lcd-upgrade-guide-v2-zh.html',
+]
+dups_en = [
+    'en/posts/article_20260503_FANUC_A61L_0001_0093_LCD.html',
+]
+
+fixed = 0
+
+# Fix Chinese duplicates
+for rel in dups_cn:
+    fpath = os.path.join(repo, rel)
+    if not os.path.exists(fpath):
+        print(f"SKIP (not found): {rel}")
+        continue
+    
+    with open(fpath, 'r', encoding='utf-8', errors='ignore') as fp:
+        content = fp.read()
+    
+    new_content = content
+    
+    # Add canonical pointing to authoritative page
+    if '<link rel="canonical"' not in new_content:
+        head_close = new_content.find('</head>')
+        if head_close > 0:
+            new_content = new_content[:head_close] + f'    <link rel="canonical" href="{auth_cn}">\n' + new_content[head_close:]
+    
+    # Add meta refresh redirect (5 seconds, give time for canonical to be read)
+    if '<meta http-equiv="refresh"' not in new_content:
+        head_close = new_content.find('</head>')
+        if head_close > 0:
+            redirect = f'    <meta http-equiv="refresh" content="5;url={auth_cn}">\n'
+            new_content = new_content[:head_close] + redirect + new_content[head_close:]
+    
+    # Add notice at top of body
+    body_pos = new_content.find('<body>')
+    if body_pos > 0 and '已合并' not in new_content[:5000]:
+        notice = '''<div style="background:#fff3cd;border:1px solid #ffc107;padding:15px;margin:10px;text-align:center;">
+            <p>⚠️ 此页面已合并到最新版本：<a href="{auth_cn}">FANUC A61L-0001-0093 完整升级指南（2026-05-26）</a></p>
+            <p>将在5秒后自动跳转... <a href="{auth_cn}" style="color:#007bff;">立即跳转</a></p>
+        </div>\n'''
+        new_content = new_content[:body_pos+len('<body>')] + notice + new_content[body_pos+len('<body>'):]
+    
+    if new_content != content:
+        with open(fpath, 'w', encoding='utf-8') as fp:
+            fp.write(new_content)
+        fixed += 1
+        print(f"Fixed (CN): {rel}")
+
+# Fix English duplicates
+for rel in dups_en:
+    fpath = os.path.join(repo, rel)
+    if not os.path.exists(fpath):
+        print(f"SKIP (not found): {rel}")
+        continue
+    
+    with open(fpath, 'r', encoding='utf-8', errors='ignore') as fp:
+        content = fp.read()
+    
+    new_content = content
+    
+    if '<link rel="canonical"' not in new_content:
+        head_close = new_content.find('</head>')
+        if head_close > 0:
+            new_content = new_content[:head_close] + f'    <link rel="canonical" href="{auth_en}">\n' + new_content[head_close:]
+    
+    if '<meta http-equiv="refresh"' not in new_content:
+        head_close = new_content.find('</head>')
+        if head_close > 0:
+            redirect = f'    <meta http-equiv="refresh" content="5;url={auth_en}">\n'
+            new_content = new_content[:head_close] + redirect + new_content[head_close:]
+    
+    body_pos = new_content.find('<body>')
+    if body_pos > 0 and 'merged' not in new_content[:5000]:
+        notice = '''<div style="background:#fff3cd;border:1px solid #ffc107;padding:15px;margin:10px;text-align:center;">
+            <p>⚠️ This page has been merged to the latest version: <a href="{auth_en}">FANUC A61L-0001-0093 Complete Upgrade Guide (2026-05-26)</a></p>
+            <p>Redirecting in 5 seconds... <a href="{auth_en}" style="color:#007bff;">Click here to go now</a></p>
+        </div>\n'''
+        new_content = new_content[:body_pos+len('<body>')] + notice + new_content[body_pos+len('<body>'):]
+    
+    if new_content != content:
+        with open(fpath, 'w', encoding='utf-8') as fp:
+            fp.write(new_content)
+        fixed += 1
+        print(f"Fixed (EN): {rel}")
+
+print(f"\nTotal fixed: {fixed}")
+print("\n=== NOTE ===")
+print(f"Authoritative CN page: {auth_cn}")
+print(f"Authoritative EN page: {auth_en}")
+print("Duplicate pages now have canonical + meta refresh redirect.")
+print("For better SEO, consider merging content into authoritative page and deleting duplicates.")
