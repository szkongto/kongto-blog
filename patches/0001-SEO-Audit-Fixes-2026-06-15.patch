diff --git a/audit_current.py b/audit_current.py
new file mode 100644
index 00000000..6deaefda
--- /dev/null
+++ b/audit_current.py
@@ -0,0 +1,67 @@
+import os, re
+
+repo = '.'
+issues = {
+    'NO_HREFLANG': [],
+    'CANONICAL_MISMATCH': [],
+    'CHINESE_URL': [],
+    'NO_NAV_COMPAT': [],
+}
+
+# Check all HTML files
+for root, dirs, files in os.walk(repo):
+    dirs[:] = [d for d in dirs if not d.startswith('.') and d not in ('images', 'css', 'schema', 'docs', 'images_backup_compressed', 'backlinks_output', 'backlinks_daily')]
+    for f in files:
+        if not f.endswith('.html'):
+            continue
+        fpath = os.path.join(root, f)
+        relpath = fpath[len(repo)+1:].replace('\\', '/')
+        
+        with open(fpath, 'r', encoding='utf-8', errors='ignore') as fp:
+            content = fp.read()
+        
+        # Check hreflang
+        if 'hreflang' not in content:
+            issues['NO_HREFLANG'].append(relpath)
+        
+        # Check canonical vs og:url
+        canonicals = re.findall(r'<link rel="canonical" href="([^"]+)"', content)
+        og_urls = re.findall(r'<meta property="og:url" content="([^"]+)"', content)
+        
+        if canonicals and og_urls:
+            if canonicals[0] != og_urls[0]:
+                issues['CANONICAL_MISMATCH'].append(f"{relpath}: canonical={canonicals[0]} og:url={og_urls[0]}")
+        elif canonicals and not og_urls:
+            issues['CANONICAL_MISMATCH'].append(f"{relpath}: has canonical but NO og:url")
+        
+        # Check URL for Chinese characters in posts
+        if '/posts/' in relpath and re.search(r'[\u4e00-\u9fff]', f):
+            issues['CHINESE_URL'].append(relpath)
+        
+        # Check if compatibility-matrix has nav
+        if 'compatibility-matrix' in f:
+            head_section = content[:5000].lower()
+            if 'nav' not in head_section and 'menu' not in head_section:
+                issues['NO_NAV_COMPAT'].append(relpath)
+
+print("=== NO_HREFLANG (pages missing hreflang) ===")
+print(f"Count: {len(issues['NO_HREFLANG'])}")
+for i in issues['NO_HREFLANG'][:30]:
+    print(f"  {i}")
+if len(issues['NO_HREFLANG']) > 30:
+    print(f"  ... and {len(issues['NO_HREFLANG']) - 30} more")
+
+print("\n=== CANONICAL_MISMATCH ===")
+print(f"Count: {len(issues['CANONICAL_MISMATCH'])}")
+for i in issues['CANONICAL_MISMATCH'][:20]:
+    print(f"  {i}")
+
+print("\n=== CHINESE_URL (URLs with Chinese chars) ===")
+print(f"Count: {len(issues['CHINESE_URL'])}")
+for i in issues['CHINESE_URL']:
+    print(f"  {i}")
+
+print("\n=== NO_NAV_COMPAT (compatibility-matrix missing nav) ===")
+print(f"Count: {len(issues['NO_NAV_COMPAT'])}")
+for i in issues['NO_NAV_COMPAT']:
+    print(f"  {i}")
